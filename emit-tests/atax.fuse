      y0[((i >> (1 as ubit<4>)) as ubit<3>)] := y_int_read0_;
    }
    if (((i & (1 as ubit<4>)) == (1 as ubit<4>))) {
      y1[((i >> (1 as ubit<4>)) as ubit<3>)] := y_int_read0_;
    }
    let tmp_int_read0_: ubit<32> = tmp_int[i];
    ---
    if (((i & (1 as ubit<4>)) == (0 as ubit<4>))) {
      tmp0[((i >> (1 as ubit<4>)) as ubit<3>)] := tmp_int_read0_;
    }
    if (((i & (1 as ubit<4>)) == (1 as ubit<4>))) {
      tmp1[((i >> (1 as ubit<4>)) as ubit<3>)] := tmp_int_read0_;
    }
    ---
    i := (i + (1 as ubit<4>));
  }
}
