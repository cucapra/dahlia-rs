let tmp1: ubit<32>[4];
{
  let i: ubit<4> = (0 as ubit<4>);
  ---
  /* @bound(8) */ while ((i <= (7 as ubit<4>))) {
    {
      let j: ubit<4> = (0 as ubit<4>);
      ---
      /* @bound(8) */ while ((j <= (7 as ubit<4>))) {
        let A_int_read0_: ubit<32> = A_int[i][j];
        ---
        if ((((j & (1 as ubit<4>)) == (0 as ubit<4>)) && ((i & (0 as ubit<4>)) == (0 as ubit<4>)))) {
          A0_0[i][((j >> (1 as ubit<4>)) as ubit<3>)] := A_int_read0_;
        }
        if ((((j & (1 as ubit<4>)) == (1 as ubit<4>)) && ((i & (0 as ubit<4>)) == (0 as ubit<4>)))) {
          A0_1[i][((j >> (1 as ubit<4>)) as ubit<3>)] := A_int_read0_;
        }
        ---
        j := (j + (1 as ubit<4>));
      }
    }
    let x_int_read0_: ubit<32> = x_int[i];
    ---
    if (((i & (1 as ubit<4>)) == (0 as ubit<4>))) {
      x0[((i >> (1 as ubit<4>)) as ubit<3>)] := x_int_read0_;
    }
    if (((i & (1 as ubit<4>)) == (1 as ubit<4>))) {
      x1[((i >> (1 as ubit<4>)) as ubit<3>)] := x_int_read0_;
    }
    let y_int_read0_: ubit<32> = y_int[i];
