          let red_read1_: ubit<32> = tmp1[((i >> (1 as ubit<4>)) as ubit<3>)];
          ---
          tmp1[((i >> (1 as ubit<4>)) as ubit<3>)] := (red_read1_ + (out_0 + out_1));
        }
