      while ((j <= (3 as ubit<4>))) {
        let A_read0_0: ubit<32>;
        let A_read0_1: ubit<32>;
        A_read0_0 := A0_0[i][(j as ubit<3>)];
        A_read0_1 := A0_1[i][(j as ubit<3>)];
        let x_read0_0: ubit<32>;
        let x_read0_1: ubit<32>;
        x_read0_0 := x0[(j as ubit<3>)];
        x_read0_1 := x1[(j as ubit<3>)];
        ---
        let bin_read0_: ubit<32> = (A_read0_0 * x_read0_0);
        ---
        let out_0: ubit<32> = bin_read0_;
        let bin_read1_: ubit<32> = (A_read0_1 * x_read0_1);
        ---
        let out_1: ubit<32> = bin_read1_;
        ---
        if (((i & (1 as ubit<4>)) == (0 as ubit<4>))) {
          let red_read0_: ubit<32> = tmp0[((i >> (1 as ubit<4>)) as ubit<3>)];
          ---
          tmp0[((i >> (1 as ubit<4>)) as ubit<3>)] := (red_read0_ + (out_0 + out_1));
        }
