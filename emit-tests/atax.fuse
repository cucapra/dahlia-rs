        let A_read1_1: ubit<32>;
        A_read1_0 := A0_0[i][(j as ubit<3>)];
        A_read1_1 := A0_1[i][(j as ubit<3>)];
        let tmp_sh_read0_0: ubit<32>;
        if (((i & (1 as ubit<4>)) == (0 as ubit<4>))) {
          tmp_sh_read0_0 := tmp0[((i >> (1 as ubit<4>)) as ubit<3>)];
        }
        if (((i & (1 as ubit<4>)) == (1 as ubit<4>))) {
          tmp_sh_read0_0 := tmp1[((i >> (1 as ubit<4>)) as ubit<3>)];
        }
        ---
        let bin_read2_: ubit<32> = (A_read1_0 * tmp_sh_read0_0);
